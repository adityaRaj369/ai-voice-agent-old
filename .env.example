# Hunar Voice AI (required for live calls). Never commit the real key.
HUNAR_API_KEY=
HUNAR_API_BASE=https://api.voice.hunar.ai

# Public URL of this backend so Hunar can POST call results (Railway/Render/ngrok).
PUBLIC_BASE_URL=http://localhost:8000

# Optional people-search providers. Demo talent graph works without these.
PDL_API_KEY=
APOLLO_API_KEY=

# Optional live WhatsApp / SMS (Twilio). Messages are logged even without this.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional email outreach.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=sqlite:///./frontline.db
